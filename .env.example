# Copy this file to .env.local for local development.
# Real values go in Vercel: Project Settings → Environment Variables.

# Supabase project URL (see README.md for where to find this). Not secret —
# used both by the client build and server-side API routes.
VITE_SUPABASE_URL=

# Server-side only — the SERVICE ROLE key (Project Settings → API → service_role,
# marked "secret"), used by api/storage.js and api/keepalive.js to read/write
# kv_store. This bypasses Row Level Security, so it must never be prefixed
# with VITE_ or otherwise bundled into the client. Do NOT use the anon/public
# key here — RLS on kv_store denies anon access entirely (see supabase-setup.sql).
SUPABASE_SERVICE_ROLE_KEY=

# Server-side only — powers the "Scan Timeslip" feature (api/scan-timeslip.js).
# Get a key at console.anthropic.com. Do NOT prefix this with VITE_ — it must
# stay server-side and never be bundled into the client.
ANTHROPIC_API_KEY=

# Copy this file to .env.local for local development.
# Real values go in Vercel: Project Settings → Environment Variables.

# Supabase (see README.md for where to find these)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only — powers the "Scan Timeslip" feature (api/scan-timeslip.js).
# Get a key at console.anthropic.com. Do NOT prefix this with VITE_ — it must
# stay server-side and never be bundled into the client.
ANTHROPIC_API_KEY=
